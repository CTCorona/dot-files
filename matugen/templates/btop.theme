# Matugen template for btop

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="{{colors.on_surface.default.hex}}"

# Title color for boxes
theme[title]="{{colors.on_surface.default.hex}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{colors.secondary.default.hex}}"

# Background color of selected items
theme[selected_bg]="{{colors.surface_variant.default.hex}}"

# Foreground color of selected items
theme[selected_fg]="{{colors.on_surface.default.hex}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{colors.outline_variant.default.hex}}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="{{colors.on_surface.default.hex}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{colors.tertiary.default.hex}}"

# Cpu box outline color
theme[cpu_box]="{{colors.secondary.default.hex}}"

# Memory/disks box outline color
theme[mem_box]="{{colors.tertiary.default.hex}}"

# Net up/down box outline color
theme[net_box]="{{colors.error.default.hex}}"

# Processes box outline color
theme[proc_box]="{{colors.primary.default.hex}}"

# Box divider line and small boxes line color
theme[div_line]="{{colors.outline_variant.default.hex}}"

# Temperature graph colors (verde -> amarillo -> rojo)
theme[temp_start]="{{colors.tertiary.default.hex}}"
theme[temp_mid]="{{colors.primary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

# CPU graph colors (verde -> amarillo -> rojo)
theme[cpu_start]="{{colors.tertiary.default.hex}}"
theme[cpu_mid]="{{colors.primary.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

# Mem/Disk free meter (rojo -> amarillo -> verde, invertido)
theme[free_start]="{{colors.error.default.hex}}"
theme[free_mid]="{{colors.primary.default.hex}}"
theme[free_end]="{{colors.tertiary.default.hex}}"

# Mem/Disk cached meter (verde -> amarillo -> rojo)
theme[cached_start]="{{colors.tertiary.default.hex}}"
theme[cached_mid]="{{colors.primary.default.hex}}"
theme[cached_end]="{{colors.error.default.hex}}"

# Mem/Disk available meter (verde -> amarillo -> rojo)
theme[available_start]="{{colors.tertiary.default.hex}}"
theme[available_mid]="{{colors.primary.default.hex}}"
theme[available_end]="{{colors.error.default.hex}}"

# Mem/Disk used meter (verde -> amarillo -> rojo)
theme[used_start]="{{colors.tertiary.default.hex}}"
theme[used_mid]="{{colors.primary.default.hex}}"
theme[used_end]="{{colors.error.default.hex}}"

# Download graph colors (verde -> amarillo -> rojo)
theme[download_start]="{{colors.tertiary.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{colors.error.default.hex}}"

# Upload graph colors (verde -> amarillo -> rojo)
theme[upload_start]="{{colors.tertiary.default.hex}}"
theme[upload_mid]="{{colors.primary.default.hex}}"
theme[upload_end]="{{colors.error.default.hex}}"
