// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "profiles": {
    "Dallonses": {
      "settings": {
        "languages": {
          "TypeScript": {
            "language_servers": ["!biome", "..."],
          },
          "TSX": {
            "language_servers": ["!biome", "..."],
          },
        },
      },
    },
    "Mango": {
      "settings": {
        "languages": {
          "TypeScript": {
            "formatter": {
              "external": {
                "command": "node_modules/.bin/biome",
                "arguments": [
                  "check",
                  "--stdin-file-path",
                  "{buffer_path}",
                  "--write",
                ],
              },
            },
          },
          "TSX": {
            "language_servers": ["!tailwindcss-intellisense-css", "..."],
            "formatter": {
              "external": {
                "command": "node_modules/.bin/biome",
                "arguments": [
                  "check",
                  "--stdin-file-path",
                  "{buffer_path}",
                  "--write",
                ],
              },
            },
          },
        },
      },
    },
  },
  "language_models": {
    "openai_compatible": {
      "GLM": {
        "api_url": "https://api.z.ai/api/coding/paas/v4",
        "available_models": [
          {
            "name": "GLM-4.7",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
            },
          },
        ],
      },
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
      },
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "context_servers": {
    "svelte": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "@sveltejs/mcp"],
    },
  },
  "file_scan_inclusions": [".env*", "**/.env*"],
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "colorize_brackets": true,
  "cursor_shape": "underline",
  "use_system_window_tabs": true,
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "active_line_width": 2,
  },
  "project_panel": {
    "git_status_indicator": true,
    "bold_folder_labels": true,
    "hide_root": true,
    "folder_icons": true,
    "file_icons": true,
    "dock": "right",
    "entry_spacing": "standard",
    "indent_size": 15,
    "indent_guides": {
      "show": "always",
    },
  },
  "terminal": {
    "font_size": 15.0,
    "font_family": "Maple Mono",
    "font_fallbacks": ["GeistMono Nerd Font Propo"],
    "toolbar": {
      "breadcrumbs": true,
    },
    "copy_on_select": true,
    "cursor_shape": "underline",
    "dock": "left",
  },
  "agent": {
    "dock": "left",
    "profiles": {},
    "inline_assistant_model": {
      "provider": "deepseek",
      "model": "deepseek-chat",
    },
    "default_profile": "ask",
    "model_parameters": [],
    "default_model": {
      "enable_thinking": false,
      "provider": "GLM",
      "model": "GLM-4.7",
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Light Charmed Icons",
    "dark": "Warm Charmed Icons",
  },
  "telemetry": {
    "metrics": false,
  },
  "lsp_document_colors": "background",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors",
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "semantic_tokens": "combined",
  "base_keymap": "VSCode",
  "ui_font_size": 15.0,
  "ui_font_family": "JetBrains Mono",
  "ui_font_weight": 400.0,
  "buffer_font_family": "Maple Mono",
  "buffer_font_weight": 500.0,
  "buffer_font_size": 14.5,
  "buffer_line_height": {
    "custom": 2.0,
  },
  // Maple Font config
  "buffer_font_features": {
    "calt": true,
    "cv01": false,
    "cv02": false,
    "cv37": true,
    "zero": true,
  },
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },
  "theme": {
    "mode": "dark",
    "light": "Kanagawa Dragon",
    "dark": "Kanagawa Dragon",
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_project_items": true,
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx", "tv", "cn"],
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "non-relative",
          },
        },
      },
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore",
          },
        },
      },
    },
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "tsgo",
        "vtsls",
        "!typescript-language-server",
        "...",
      ],
    },
    "TSX": {
      "language_servers": [
        "tsgo",
        "vtsls",
        "!typescript-language-server",
        "...",
      ],
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "...",
      ],
    },
  },
}
