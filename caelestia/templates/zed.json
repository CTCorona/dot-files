{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Caelestia",
  "author": "ctcc",
  "themes": [
    {
      "name": "Caelestia",
      "appearance": "dark",
      "style": {
        "border": "#{{ surfaceContainerLowest.hex }}",
        "border.variant": "#{{ surfaceContainer.hex }}",
        "border.focused": "#{{ primary.hex }}",
        "border.selected": "#{{ surfaceContainerHigh.hex }}",
        "border.transparent": null,
        "border.disabled": "#{{ surfaceContainerLow.hex }}",
        "elevated_surface.background": "#{{ surfaceContainerLow.hex }}",
        "surface.background": "#{{ surfaceContainerLow.hex }}",
        "background": "#{{ background.hex }}",
        "element.background": "#{{ surfaceContainerHigh.hex }}",
        "element.hover": "#{{ surfaceContainerHighest.hex }}",
        "element.active": "#{{ surfaceBright.hex }}",
        "element.selected": "#{{ primaryContainer.hex }}",
        "element.disabled": "#{{ surfaceContainerLow.hex }}",
        "drop_target.background": "#{{ surfaceVariant.hex }}",
        "ghost_element.background": null,
        "ghost_element.hover": "#{{ surfaceContainerHigh.hex }}",
        "ghost_element.active": "#{{ surfaceContainerHighest.hex }}",
        "ghost_element.selected": "#{{ surfaceContainerHighest.hex }}",
        "ghost_element.disabled": null,
        "text": "#{{ onSurface.hex }}",
        "text.muted": "#{{ subtext1.hex }}",
        "text.placeholder": "#{{ subtext0.hex }}",
        "text.disabled": "#{{ overlay2.hex }}",
        "text.accent": "#{{ primary.hex }}",
        "icon": "#{{ subtext1.hex }}",
        "icon.muted": "#{{ subtext0.hex }}",
        "icon.disabled": "#{{ overlay1.hex }}",
        "icon.placeholder": "#{{ overlay2.hex }}",
        "icon.accent": "#{{ primary.hex }}",
        "status_bar.background": "#{{ surfaceContainerLowest.hex }}",
        "title_bar.background": "#{{ surfaceContainerLowest.hex }}",
        "toolbar.background": "#{{ background.hex }}",
        "tab_bar.background": "#{{ surfaceContainerLowest.hex }}",
        "tab.inactive_background": "#{{ surfaceContainerLowest.hex }}",
        "tab.active_background": "#{{ background.hex }}",
        "search.match_background": "#{{ primaryContainer.hex }}",
        "panel.background": "#{{ surfaceContainerLow.hex }}",
        "panel.focused_border": "#{{ primary.hex }}",
        "pane_group.border": "#{{ surfaceContainerLow.hex }}",
        "scrollbar.thumb.background": "#{{ surfaceContainerHighest.hex }}",
        "scrollbar.thumb.hover_background": "#{{ surfaceVariant.hex }}",
        "scrollbar.thumb.border": "#{{ background.hex }}",
        "scrollbar.track.background": "#{{ background.hex }}",
        "scrollbar.track.border": "#{{ background.hex }}",
        "editor.background": "#{{ background.hex }}",
        "editor.foreground": "#{{ onSurface.hex }}",
        "editor.active_line.background": "#{{ surfaceContainer.hex }}",
        "editor.highlighted_line.background": "#{{ surfaceContainerHigh.hex }}",
        "editor.line_number": "#{{ overlay1.hex }}",
        "editor.active_line_number": "#{{ onSurface.hex }}",
        "editor.invisible": "#{{ overlay0.hex }}",
        "editor.wrap_guide": "#{{ surfaceContainer.hex }}",
        "editor.active_wrap_guide": "#{{ surfaceVariant.hex }}",
        "editor.gutter.background": "#{{ background.hex }}",
        "editor.indent_guide": "#{{ surfaceContainer.hex }}",
        "editor.indent_guide_active": "#{{ outline.hex }}",
        "selection": "#{{ surfaceVariant.hex }}",
        "error": "#{{ error.hex }}",
        "error.background": "#{{ errorContainer.hex }}",
        "error.border": "#{{ error.hex }}",
        "warning": "#{{ yellow.hex }}",
        "warning.background": "#{{ surfaceContainerHigh.hex }}",
        "warning.border": "#{{ yellow.hex }}",
        "info": "#{{ blue.hex }}",
        "info.background": "#{{ surfaceContainerLow.hex }}",
        "info.border": "#{{ blue.hex }}",
        "success": "#{{ success.hex }}",
        "success.background": "#{{ successContainer.hex }}",
        "success.border": "#{{ success.hex }}",
        "hint": "#{{ subtext0.hex }}",
        "hint.background": "#{{ background.hex }}",
        "hint.border": "#{{ subtext1.hex }}",
        "terminal.background": "#{{ background.hex }}",
        "terminal.foreground": "#{{ onSurface.hex }}",
        "terminal.ansi.black": "#{{ term0.hex }}",
        "terminal.ansi.red": "#{{ term1.hex }}",
        "terminal.ansi.green": "#{{ term2.hex }}",
        "terminal.ansi.yellow": "#{{ term3.hex }}",
        "terminal.ansi.blue": "#{{ term4.hex }}",
        "terminal.ansi.magenta": "#{{ term5.hex }}",
        "terminal.ansi.cyan": "#{{ term6.hex }}",
        "terminal.ansi.white": "#{{ term7.hex }}",
        "terminal.ansi.bright_black": "#{{ term8.hex }}",
        "terminal.ansi.bright_red": "#{{ term9.hex }}",
        "terminal.ansi.bright_green": "#{{ term10.hex }}",
        "terminal.ansi.bright_yellow": "#{{ term11.hex }}",
        "terminal.ansi.bright_blue": "#{{ term12.hex }}",
        "terminal.ansi.bright_magenta": "#{{ term13.hex }}",
        "terminal.ansi.bright_cyan": "#{{ term14.hex }}",
        "terminal.ansi.bright_white": "#{{ term15.hex }}",
        "syntax": {
          "comment": { "color": "#{{ subtext0.hex }}", "font_style": "italic" },
          "string": { "color": "#{{ green.hex }}" },
          "string.escape": {
            "color": "#{{ flamingo.hex }}",
            "font_weight": 700
          },
          "string.regex": { "color": "#{{ peach.hex }}" },
          "string.special": { "color": "#{{ rosewater.hex }}" },
          "number": { "color": "#{{ mauve.hex }}" },
          "boolean": { "color": "#{{ peach.hex }}", "font_weight": 700 },
          "variable": { "color": "#{{ text.hex }}" },
          "variable.parameter": { "color": "#{{ lavender.hex }}" },
          "keyword": { "color": "#{{ mauve.hex }}" },
          "keyword.function": { "color": "#{{ blue.hex }}" },
          "keyword.return": { "color": "#{{ red.hex }}", "font_weight": 700 },
          "keyword.operator": { "color": "#{{ sky.hex }}" },
          "function": { "color": "#{{ blue.hex }}" },
          "function.method": { "color": "#{{ sapphire.hex }}" },
          "type": { "color": "#{{ yellow.hex }}" },
          "constant": { "color": "#{{ peach.hex }}" },
          "property": { "color": "#{{ lavender.hex }}" },
          "punctuation": { "color": "#{{ teal.hex }}" },
          "tag": { "color": "#{{ mauve.hex }}" },
          "attribute": { "color": "#{{ yellow.hex }}", "font_style": "italic" }
        }
      }
    }
  ]
}
